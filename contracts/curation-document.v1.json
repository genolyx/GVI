              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End"
        },
        "ensemblTranscriptId": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ensembltranscriptid"
        },
        "exon": {
          "$ref": "#/$defs/CurationExon"
        },
        "gene": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Gene",
          "type": "string"
        },
        "hgvsC": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Hgvsc",
          "type": "string"
        },
        "hgvsP": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hgvsp"
        },
        "proteinLength": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Proteinlength"
        },
        "referenceAllele": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Referenceallele"
        },
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "strand": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Strand"
        },
        "transcript": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transcript"
        }
      },
      "required": [
        "gene",
        "effectiveGene",
        "transcript",
        "ensemblTranscriptId",
        "hgvsC",
        "hgvsP",
        "consequence",
        "chromosome",
        "start",
        "end",
        "referenceAllele",
        "alternateAllele",
        "strand",
        "proteinLength",
        "exon"
      ],
      "title": "CurationVariant",
      "type": "object"
    },

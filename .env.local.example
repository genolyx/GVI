# ─────────────────────────────────────────────────────────────────
# GVI local development environment variables (Mac Studio / Docker Compose)
# Copy this file to .env.local and fill in the values.
# .env.local is excluded from commits via .gitignore.
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3010

# ── App basics ───────────────────────────────────────────────────
VITE_APP_ID=gvi-local

# JWT session signing key (min 32 chars; any string is fine for local dev)
JWT_SECRET=local-dev-secret-change-this-in-production-!!

# ── Database (postgres service in docker-compose) ─────────────────
DATABASE_URL=postgresql://gvi_user:gvi_password@localhost:5433/gvi

# ── Redis (shared engine cache + external-API rate limiting) ──────
REDIS_URL=redis://localhost:6380

# ── S3-compatible storage (minio service in docker-compose) ──────
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=gvi_minio_user
AWS_SECRET_ACCESS_KEY=gvi_minio_password
AWS_BUCKET=gvi-storage
# URL the browser uses to access files (MinIO presigned URLs use this address)
AWS_PUBLIC_URL=http://localhost:9000/gvi-storage

# ── Local dev login bypass ────────────────────────────────────────
# Set to true to activate the /api/dev/login endpoint.
# Ignored when NODE_ENV=production.
DEV_AUTH=true
# Client UI flag for the Dev Login form (must match DEV_AUTH for local bypass).
VITE_DEV_AUTH=true

# ── Platform admins (organization provisioning) ───────────────────
# Comma-separated emails. Matching users get users.role=admin on login
# and may call organizations.create. Org membership invites remain separate.
PLATFORM_ADMIN_EMAILS=admin@localhost,kenneth@genolyx.com

# ── Super administrators (cross-organization access) ──────────────
# Comma-separated emails. Matching users get users.role=super_admin on login.
# They can open every organization without being added as a member.
# A super administrator is also a platform admin. This list is separate so a
# future platform admin can create organizations without seeing every workspace.
SUPER_ADMIN_EMAILS=admin@localhost,kenneth@genolyx.com,sam@genolyx.com

# ── Google (Gmail) OAuth ──────────────────────────────────────────
# Create a Web application OAuth client in Google Cloud Console:
#   APIs & Services → Credentials → Create OAuth client ID
# Authorized redirect URI (local):
#   http://localhost:3010/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional exact redirect override (defaults to request host + /api/auth/google/callback)
# GOOGLE_REDIRECT_URI=http://localhost:3010/api/auth/google/callback
# Show "Continue with Google" on the login screen (set true after credentials above).
# VITE_GOOGLE_AUTH=true

# ── AI Copilot (optional) ─────────────────────────────────────────
# OpenAI-compatible chat completions base URL + API key
# LLM_API_URL=https://api.openai.com
# LLM_API_KEY=

# ── Site Gateway (optional) ───────────────────────────────────────
# Set when integrating with an internal gx-daemon (min 32 chars)
# GVI_GATEWAY_TOKEN=

# ── Curation engine (SAM-VC Python worker) ────────────────────────
# Shared secret the worker presents to /api/engine/v1/* (min 32 chars).
ENGINE_WORKER_TOKEN=local-dev-engine-worker-token-change-me!!
# Base URL the worker uses to reach this control plane.
ENGINE_API_URL=http://localhost:3010
# Seconds a claimed curation run stays leased before the reaper requeues it.
ENGINE_LEASE_SECONDS=900

# ── Durable Somatic interpretation worker ────────────────────────
# DB-backed queue polling interval and lease. A crashed worker's active run is
# reclaimed after the lease expires; failed runs use bounded exponential retry.
SOMATIC_WORKER_POLL_MS=2000
SOMATIC_WORKER_LEASE_SECONDS=300
SOMATIC_WORKER_MAX_ATTEMPTS=3

# ── Pinned Somatic INDEL reference FASTA ─────────────────────────
# Optional until the institution approves exact references. Each configured
# FASTA requires a samtools-compatible .fai beside it and an independently
# verified full-file SHA-256. The digest is checked once per server process.
# Without these values INDELs remain manual-review-only.
# SOMATIC_REFERENCE_FASTA_GRCH37=/data/reference/GRCh37.fa
# SOMATIC_REFERENCE_FASTA_GRCH37_SHA256=
# SOMATIC_REFERENCE_FASTA_GRCH37_VERSION=GRCh37-approved-release
# SOMATIC_REFERENCE_FASTA_GRCH38=/data/reference/GRCh38.fa
# SOMATIC_REFERENCE_FASTA_GRCH38_SHA256=
# SOMATIC_REFERENCE_FASTA_GRCH38_VERSION=GRCh38-approved-release

# Reference data root for the engine (ClinVar / ClinGen / HGMD).
VC_DATA_ROOT=~/Documents/Ploidy/VariantCurationData
# Per-file overrides (optional)
# VC_CLINVAR_PATH=
# VC_CLINGEN_PATH=
# VC_HGMD_PATH=

# HGMD is a proprietary dataset. Set to false to skip mounting it entirely;
# the curation document then records `hgmd` under meta.sourcesDisabled.
ENGINE_HGMD_ENABLED=true

# NCBI eutils is throttled to ~3 req/s without a key and ~10 req/s with one.
# NCBI_API_KEY=

# ── Somatic knowledge providers ──────────────────────────────────
# CIViC remains an organization-approved, version-pinned offline release.
# OncoKB is an explicitly enabled API provider; it never replaces missing CIViC.
# disabled | demo | research | commercial
ONCOKB_API_MODE=disabled
# Add only after OncoKB approves the account. Keep this in a secret manager in
# production; it is never stored in the database or audit payload.
# ONCOKB_API_TOKEN=
# Demo defaults to https://demo.oncokb.org; other modes default to
# https://www.oncokb.org. Override only for an approved endpoint/proxy.
# ONCOKB_BASE_URL=https://www.oncokb.org
ONCOKB_BATCH_SIZE=100
ONCOKB_MAX_CONCURRENCY=3
ONCOKB_REQUEST_TIMEOUT_SECONDS=60
ONCOKB_RETRY_COUNT=3
ONCOKB_CACHE_TTL_SECONDS=86400
# Research/demo evidence is retained for evaluation but cannot enter a Clinical
# Report. Commercial mode also requires an enabled, license-approved OncoKB
# provider and an active organization policy with enableOncoKb=true.
# Optional offline CIViC import worker credential.
# CIVIC_API_KEY=
# CIViC GraphQL is used only to build a draft, version-pinned offline release.
# The clinical interpretation path never falls back to the live API. Raw API
# bodies are archived in object storage, so AWS_* configuration above is
# required before starting an import.
CIVIC_IMPORT_POLL_MS=5000
CIVIC_IMPORT_LEASE_SECONDS=300
CIVIC_IMPORT_MAX_ATTEMPTS=3
CIVIC_IMPORT_REQUEST_TIMEOUT_MS=15000
CIVIC_IMPORT_REQUEST_RETRIES=3
CIVIC_IMPORT_REQUEST_INTERVAL_MS=1000
CIVIC_IMPORT_PAGE_SIZE=25
CIVIC_IMPORT_MAX_PAGES=100
# CI contract introspection result. Pin the approved GraphQL schema hash before
# production import; a missing value is represented by the adapter's sentinel.
# CIVIC_SCHEMA_HASH=

# Engine LLM (gene profile + literature summaries). The worker calls
# POST /api/engine/v1/llm on this control plane — it does not hold a model key.
# Configure LLM_API_URL / LLM_API_KEY above to enable. Leave Gemini disabled to
# skip those summaries entirely.
VC_DISABLE_GEMINI=1
# GEMINI_API_KEY=  # standalone fallback only; prefer the GVI proxy
